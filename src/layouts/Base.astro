---
import '@fontsource-variable/geist';
import '@fontsource-variable/geist-mono';
import '@fontsource/redaction-35/400-italic.css';
import '../styles/global.css';
import Analytics from '../components/Analytics.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { site } from '../data/site';

interface Props {
	title?: string;
	description?: string;
	ogType?: 'website' | 'article';
}

const { title, description = site.description, ogType = 'website' } = Astro.props;
const fullTitle = title ? `${title} · ${site.name}` : site.name;
const canonical = new URL(Astro.url.pathname, Astro.site);
---

<!doctype html>
<html lang="en" data-theme="dark">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<meta name="generator" content={Astro.generator} />
		<title>{fullTitle}</title>
		<meta name="description" content={description} />
		<link rel="canonical" href={canonical} />
		<link rel="icon" type="image/png" href="/favicon.png" />
		<link rel="alternate" type="application/rss+xml" title={`${site.name} — writing`} href="/rss.xml" />
		<meta property="og:type" content={ogType} />
		<meta property="og:title" content={fullTitle} />
		<meta property="og:description" content={description} />
		<meta property="og:url" content={canonical} />
		<meta property="og:image" content={new URL('/og.jpg', Astro.site)} />
		<meta name="twitter:card" content="summary" />
		<meta name="twitter:creator" content={`@${site.handle}`} />
		<script is:inline>
			(() => {
				let t = 'dark';
				try { t = localStorage.getItem('theme') || 'dark'; } catch {}
				document.documentElement.dataset.theme = t;
			})();
		</script>
		<Analytics />
	</head>
	<body>
		<div class="page">
			<Header />
			<main class="stagger" style="--d:340ms">
				<slot />
			</main>
			<Footer />
		</div>
	</body>
</html>

<style is:global>
	/* the intro staggers its own children, so it doesn't also rise as a block */
	main.stagger > .intro { animation: none; }
	.page {
		max-width: var(--col);
		margin-inline: auto;
		padding: 2rem 1.5rem 3rem;
	}

	/* sections: a hairline, a small muted title, then rows */
	.section { margin-top: 1.75rem; padding-top: 1.5rem; border-top: 1px solid var(--line); }
	.section-title { margin: 0 0 .75rem; font-size: 14px; font-weight: 400; color: var(--ink-2); }

	.rows { list-style: none; margin: 0 -.5rem; padding: 0; }
	.row {
		display: flex; align-items: center; justify-content: space-between; gap: 1rem;
		padding: .3rem .5rem; border-radius: .4rem;
		color: inherit; text-decoration: none;
		transition: background-color .15s ease;
	}
	.row:hover { background: var(--hover); }
	.row-main { min-width: 0; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
	.row-name { color: var(--ink); }
	.row-desc { color: var(--ink-2); }
	.row-desc::before { content: '~'; margin: 0 .4rem; color: var(--ink-3); }
	@media (max-width: 34rem) {
		.row-main { white-space: normal; }
		.row-meta.icons { display: none; }
	}
	.row-meta { flex: none; display: inline-flex; align-items: center; gap: .5rem; color: var(--ink-2); font-variant-numeric: tabular-nums; }
</style>
