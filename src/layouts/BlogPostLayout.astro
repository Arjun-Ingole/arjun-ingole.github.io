---
import Base from './Base.astro';
import { fmtDate } from '../lib/posts';

const metadata = Astro.props.frontmatter ?? Astro.props;
const { title, description, date, readTime } = metadata;
const d = new Date(date);
---

<Base title={title} description={description} ogType="article">
	<article>
		<header class="head">
			<a class="back" href="/blog">← Writing</a>
			<h1>{title}</h1>
			<p class="meta">
				<time datetime={isNaN(+d) ? undefined : d.toISOString()}>{isNaN(+d) ? date : fmtDate(d, 'long')}</time>
				{readTime && <span> · {readTime}</span>}
			</p>
		</header>
		<div class="prose"><slot /></div>
	</article>
</Base>

<style>
	.head { margin-bottom: 2rem; }
	.back { display: inline-block; margin-bottom: 1.5rem; color: var(--ink-3); text-decoration: none; transition: color .15s ease; }
	.back:hover { color: var(--ink); }
	h1 { margin: 0; font-size: 1.25rem; font-weight: 500; line-height: 1.35; letter-spacing: -.01em; text-wrap: balance; }
	.meta { margin: .35rem 0 0; color: var(--ink-3); }

	.prose { font-size: 15px; line-height: 1.75; color: var(--ink-2); text-wrap: pretty; }
	.prose :global(p) { margin: 0 0 1.25rem; }
	.prose :global(h2), .prose :global(h3), .prose :global(h4) { margin: 2.25rem 0 .75rem; color: var(--ink); font-size: 15px; font-weight: 500; }
	.prose :global(ul), .prose :global(ol) { margin: 0 0 1.25rem; padding-left: 1.25rem; }
	.prose :global(ul) { list-style: disc; }
	.prose :global(ol) { list-style: decimal; }
	.prose :global(li) { margin: .35rem 0; padding-left: .25rem; }
	.prose :global(li::marker) { color: var(--ink-3); }
	.prose :global(blockquote) { margin: 1.5rem 0; padding-left: 1rem; border-left: 2px solid var(--line); color: var(--ink); }
	.prose :global(blockquote p) { margin: 0; }
	.prose :global(a) { color: var(--ink); text-decoration: underline; text-decoration-color: var(--ink-3); text-underline-offset: 3px; }
	.prose :global(a:hover) { text-decoration-color: var(--ink); }
	.prose :global(strong) { color: var(--ink); font-weight: 500; }
	.prose :global(mark), .prose :global(:not(pre) > code) {
		padding: .1rem .3rem; border: 1px solid var(--line); border-radius: .3rem;
		background: var(--hover); color: var(--ink); font-family: var(--font-mono); font-size: .85em;
	}
	.prose :global(.astro-code) {
		overflow-x: auto; margin: 1.5rem 0; padding: 1rem 1.1rem;
		border: 1px solid var(--line); border-radius: .5rem;
		font-family: var(--font-mono); font-size: 12.5px; line-height: 1.65;
	}
	.prose :global(table) { width: 100%; margin: 1.5rem 0; border-collapse: collapse; table-layout: fixed; font-size: 12.5px; line-height: 1.45; }
	.prose :global(th), .prose :global(td) { padding: .5rem .6rem; border: 1px solid var(--line); text-align: left; vertical-align: top; overflow-wrap: anywhere; }
	.prose :global(th) { color: var(--ink); font-weight: 500; background: var(--hover); }
	.prose :global(th:first-child), .prose :global(td:first-child) { width: 28%; }
	.prose :global(hr) { margin: 2.5rem 0; border: 0; border-top: 1px solid var(--line); }
	.prose :global(img) { max-width: 100%; border-radius: .5rem; }
</style>
