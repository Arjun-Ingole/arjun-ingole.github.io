---
// Live listening from last.fm (spotify → last.fm scrobbling). Renders nothing
// until lastfm.user and lastfm.apiKey are set in src/data/site.ts.
import { lastfm } from '../data/site';
const enabled = Boolean(lastfm.user && lastfm.apiKey);
---

{enabled && (
	<a class="np" data-np data-user={lastfm.user} data-key={lastfm.apiKey} href={`https://www.last.fm/user/${lastfm.user}`} target="_blank" rel="noopener noreferrer" aria-live="polite">
		<span class="np-art"><img data-np-art alt="" width="40" height="40" /></span>
		<span class="np-text">
			<span class="np-title" data-np-title>&nbsp;</span>
			<span class="np-sub"><span data-np-artist>&nbsp;</span><span class="np-status" data-np-status></span></span>
		</span>
		<span class="np-eq" aria-hidden="true"><i></i><i></i><i></i></span>
	</a>
)}

<style>
	.np {
		display: flex; align-items: center; gap: .75rem;
		margin: 1rem -.5rem .9rem; padding: .45rem .5rem; border-radius: .6rem;
		color: inherit; text-decoration: none;
		opacity: 0; transform: translateY(6px); filter: blur(4px);
		transition: opacity .6s ease, transform .7s cubic-bezier(.22,1,.36,1), filter .6s ease, background-color .15s ease;
	}
	.np.ready { opacity: 1; transform: none; filter: none; }
	.np:hover { background: var(--hover); }
	.np-art {
		position: relative; flex: none; width: 40px; height: 40px; border-radius: 6px; overflow: hidden;
		background: var(--line);
	}
	.np-art img { display: block; width: 100%; height: 100%; object-fit: cover; opacity: 0; transition: opacity .3s ease; }
	.np-art img.loaded { opacity: 1; }
	.np-text { display: flex; flex-direction: column; min-width: 0; flex: 1; line-height: 1.35; }
	.np-title, .np-sub { overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
	.np-title { color: var(--ink); }
	.np-sub { color: var(--ink-2); }
	.np-status { color: var(--ink-3); }
	.np-status:not(:empty)::before { content: '·'; margin: 0 .4rem; }
	.np.live .np-status { color: #1db954; }

	/* equalizer, only while something is actually playing */
	.np-eq { display: none; align-items: flex-end; gap: 2px; height: 12px; flex: none; }
	.np.live .np-eq { display: inline-flex; }
	.np-eq i { width: 3px; height: 100%; border-radius: 1px; background: #1db954; transform-origin: bottom; animation: eq 1s ease-in-out infinite; }
	.np-eq i:nth-child(2) { animation-delay: -.4s; animation-duration: .8s; }
	.np-eq i:nth-child(3) { animation-delay: -.7s; animation-duration: 1.1s; }
	@keyframes eq { 0%, 100% { transform: scaleY(.3); } 50% { transform: scaleY(1); } }
	@media (prefers-reduced-motion: reduce) { .np-eq i { animation: none; transform: scaleY(.6); } }
</style>

<script>
	const el = document.querySelector<HTMLAnchorElement>('[data-np]');
	if (el) {
		const $ = (s: string) => el.querySelector<HTMLElement>(s)!;
		const art = $('[data-np-art]') as HTMLImageElement;
		const url = `https://ws.audioscrobbler.com/2.0/?method=user.getrecenttracks&user=${encodeURIComponent(el.dataset.user!)}&api_key=${el.dataset.key}&format=json&limit=1`;

		const ago = (uts: number) => {
			const s = Math.max(0, Date.now() / 1000 - uts);
			if (s < 60) return 'just now';
			const [n, u] = s < 3600 ? [s / 60, 'm'] : s < 86400 ? [s / 3600, 'h'] : [s / 86400, 'd'];
			return `played ${Math.floor(n)}${u} ago`;
		};

		const load = async () => {
			try {
				const res = await fetch(url);
				if (!res.ok) throw new Error(String(res.status));
				const t = (await res.json())?.recenttracks?.track?.[0];
				if (!t) throw new Error('no tracks');
				const live = t['@attr']?.nowplaying === 'true';
				$('[data-np-title]').textContent = t.name;
				$('[data-np-artist]').textContent = t.artist?.['#text'] ?? '';
				$('[data-np-status]').textContent = live ? 'listening now' : t.date?.uts ? ago(+t.date.uts) : '';
				el.href = t.url || el.href;
				el.title = `${t.name} — ${t.artist?.['#text'] ?? ''}`;
				// last.fm's image list goes small → extralarge; its placeholder star has this hash
				const img = (t.image ?? []).map((i: any) => i['#text']).filter(Boolean).pop();
				if (img && !img.includes('2a96cbd8b46e442fc41c2b86b821562f')) {
					if (art.src !== img) { art.classList.remove('loaded'); art.onload = () => art.classList.add('loaded'); art.src = img; }
				} else {
					art.removeAttribute('src'); art.classList.remove('loaded');
				}
				el.classList.toggle('live', live);
				el.classList.add('ready');
			} catch {
				if (!el.classList.contains('ready')) el.remove();
			}
		};

		load();
		let timer = setInterval(load, 30_000);
		document.addEventListener('visibilitychange', () => {
			clearInterval(timer);
			if (!document.hidden) { load(); timer = setInterval(load, 30_000); }
		});
	}
</script>
