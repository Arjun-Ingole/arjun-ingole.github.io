---
// GitHub contributions for the last year, fetched at build time. If the API is
// unreachable the section simply doesn't render — the build never fails on it.
import { site, links } from '../data/site';

interface Day { date: string; count: number; level: 0 | 1 | 2 | 3 | 4 }
let days: Day[] = [];
let total = 0;
try {
	const res = await fetch(`https://github-contributions-api.jogruber.de/v4/${site.githubUser}?y=last`, {
		signal: AbortSignal.timeout(8000),
	});
	if (res.ok) {
		const json = await res.json();
		days = json.contributions ?? [];
		total = json.total?.lastYear ?? days.reduce((n: number, d: Day) => n + d.count, 0);
	}
} catch {}

// pad the front so every column is a sunday → saturday week
const lead = days.length ? new Date(days[0].date + 'T00:00:00Z').getUTCDay() : 0;
const cells: (Day | null)[] = [...Array(lead).fill(null), ...days];
const weeks: (Day | null)[][] = [];
for (let i = 0; i < cells.length; i += 7) weeks.push(cells.slice(i, i + 7));

const label = (d: Day) => {
	const date = new Date(d.date + 'T00:00:00Z').toLocaleDateString('en-US', { month: 'short', day: 'numeric', timeZone: 'UTC' });
	return `${d.count || 'No'} contribution${d.count === 1 ? '' : 's'} on ${date}`;
};
---

{days.length > 0 && (
	<section class="section" id="github">
		<div class="head">
			<h2 class="section-title">GitHub</h2>
			<a class="total" href={links.github} target="_blank" rel="noopener noreferrer">{total.toLocaleString('en-US')} contributions in the last year</a>
		</div>
		<div class="scroll" data-cg>
			<div class="grid" style={`--weeks:${weeks.length}`}>
				{weeks.map((w, wi) => (
					<div class="week" style={`--w:${wi}`}>
						{w.map((d) => d
							? <span class="cell" data-l={d.level} data-tip={label(d)}></span>
							: <span class="cell empty"></span>)}
					</div>
				))}
			</div>
		</div>
		<div class="tip" data-cg-tip aria-hidden="true"></div>
	</section>
)}

<style>
	.head { display: flex; align-items: baseline; justify-content: space-between; gap: 1rem; }
	.total { color: var(--ink-3); text-decoration: none; font-variant-numeric: tabular-nums; transition: color .15s ease; }
	.total:hover { color: var(--ink); }

	.scroll { overflow-x: auto; scrollbar-width: none; }
	.scroll::-webkit-scrollbar { display: none; }
	.grid { display: grid; grid-template-columns: repeat(var(--weeks), 1fr); gap: 2px; min-width: 30rem; }
	.week { display: grid; grid-template-rows: repeat(7, 1fr); gap: 2px; }

	/* github's own greens, light and dark */
	.cell {
		aspect-ratio: 1; border-radius: 2px; background: var(--line);
		--g1: #9be9a8; --g2: #40c463; --g3: #30a14e; --g4: #216e39;
	}
	:global([data-theme='dark']) .cell { --g1: #0e4429; --g2: #006d32; --g3: #26a641; --g4: #39d353; }
	.cell.empty { background: transparent; }
	.cell[data-l='1'] { background: var(--g1); }
	.cell[data-l='2'] { background: var(--g2); }
	.cell[data-l='3'] { background: var(--g3); }
	.cell[data-l='4'] { background: var(--g4); }
	/* sweeps in left → right, one week at a time, when scrolled into view */
	.week { opacity: 0; transform: translateY(3px); }
	.scroll.seen .week {
		opacity: 1; transform: none;
		transition: opacity .5s ease, transform .5s cubic-bezier(.22,1,.36,1);
		transition-delay: calc(var(--w) * 12ms);
	}
	@media (prefers-reduced-motion: reduce) { .week { opacity: 1; transform: none; } }
	.cell[data-tip]:hover { outline: 1px solid var(--ink-2); outline-offset: 0; }

	.tip {
		position: fixed; left: 0; top: 0; z-index: 60; pointer-events: none;
		padding: .25rem .5rem; border-radius: .35rem;
		background: var(--ink); color: var(--bg); font-size: 12px; white-space: nowrap;
		opacity: 0; transform: translate(-50%, calc(-100% - 6px));
		transition: opacity .1s ease;
	}
	.tip.on { opacity: 1; }
</style>

<script>
	const root = document.querySelector<HTMLElement>('[data-cg]');
	const tip = document.querySelector<HTMLElement>('[data-cg-tip]');
	if (root && tip) {
		// narrow screens scroll the grid; start at the most recent weeks
		root.scrollLeft = root.scrollWidth;
		new IntersectionObserver((entries, io) => {
			if (entries[0].isIntersecting) { root.classList.add('seen'); io.disconnect(); }
		}, { threshold: 0.25 }).observe(root);
		root.addEventListener('pointerover', (e) => {
			const c = (e.target as HTMLElement).closest<HTMLElement>('[data-tip]');
			if (!c) return tip.classList.remove('on');
			const r = c.getBoundingClientRect();
			tip.textContent = c.dataset.tip!;
			tip.style.left = `${r.left + r.width / 2}px`;
			tip.style.top = `${r.top}px`;
			tip.classList.add('on');
		});
		root.addEventListener('pointerleave', () => tip.classList.remove('on'));
		root.addEventListener('scroll', () => tip.classList.remove('on'), { passive: true });
	}
</script>
