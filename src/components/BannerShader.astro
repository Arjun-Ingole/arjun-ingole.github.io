---
// The X banner run through a CRT shader: scanlines, aperture grille, slight
// tube curvature, colour fringing, and a ripple that follows the cursor.
// The plain <img> shows until the first frame renders (and stays if WebGL
// isn't available).
interface Props {
	src?: string;
	alt?: string;
	class?: string;
}
const { src = '/banner.jpg', alt = '', class: cls } = Astro.props;
---

<div class:list={['banner', cls]} data-banner data-src={src}>
	<img class="banner-fallback" src={src} alt={alt} width="1500" height="500" decoding="async" />
	<canvas class="banner-gl" aria-hidden="true"></canvas>
</div>

<style>
	.banner {
		position: relative; overflow: hidden;
		aspect-ratio: 3 / 1; border-radius: 12px;
		background: var(--line);
		isolation: isolate;
	}
	.banner-fallback, .banner-gl { position: absolute; inset: 0; width: 100%; height: 100%; display: block; }
	.banner-fallback { object-fit: cover; }
	.banner-gl { opacity: 0; transition: opacity .6s ease; touch-action: pan-y; }
	.banner.gl-ready .banner-gl { opacity: 1; }
	/* once the shader is up, let its transparent tube corners show the page */
	.banner-fallback { transition: opacity .6s ease; }
	.banner.gl-ready .banner-fallback { opacity: 0; }
	.banner { transition: background-color .6s ease; }
	.banner.gl-ready { background: transparent; }
	.banner.gl-ready::after { display: none; }
	.banner::after {
		content: ''; position: absolute; inset: 0; border-radius: inherit; pointer-events: none;
		box-shadow: inset 0 0 0 1px rgb(0 0 0 / .06);
	}
	:global([data-theme='dark']) .banner::after { box-shadow: inset 0 0 0 1px rgb(255 255 255 / .06); }
</style>

<script>
	const VERT = `#version 300 es
	void main() {
		vec2 p = vec2((gl_VertexID << 1) & 2, gl_VertexID & 2);
		gl_Position = vec4(p * 2.0 - 1.0, 0.0, 1.0);
	}`;

	const FRAG = `#version 300 es
	precision highp float;
	uniform sampler2D uTex;
	uniform vec2 uRes;      // canvas, device px
	uniform vec2 uImg;      // image size
	uniform vec2 uMouse;    // device px, bottom-left origin
	uniform float uHover;   // 0..1, eased
	uniform float uTime;
	uniform float uDpr;
	out vec4 o;

	vec2 cover(vec2 uv) {
		float ra = uRes.x / uRes.y, ia = uImg.x / uImg.y;
		if (ra > ia) { float s = ia / ra; uv.y = uv.y * s + (1.0 - s) * 0.5; }
		else { float s = ra / ia; uv.x = uv.x * s + (1.0 - s) * 0.5; }
		return uv;
	}
	vec3 sampleRGB(vec2 uv, float ab) {
		return vec3(
			texture(uTex, cover(uv + vec2(ab, 0.0))).r,
			texture(uTex, cover(uv)).g,
			texture(uTex, cover(uv - vec2(ab, 0.0))).b);
	}
	void main() {
		vec2 uv = gl_FragCoord.xy / uRes;
		vec2 cc = uv - 0.5;
		vec2 bu = uv + cc * dot(cc, cc) * 0.06;           // slight tube curvature
		vec2 md = gl_FragCoord.xy - uMouse;                 // ripple out from the cursor
		float dist = length(md);
		float rip = sin(dist / (5.0 * uDpr) - uTime * 7.0) * exp(-dist / (110.0 * uDpr)) * uHover;
		bu += (md / max(dist, 1.0)) * rip * 0.004;
		vec3 col = sampleRGB(bu, 0.0012 + length(cc) * 0.003);
		float y = gl_FragCoord.y / uDpr;
		col *= 0.82 + 0.18 * sin(y * 3.14159);              // scanlines
		float m = mod(gl_FragCoord.x / uDpr, 3.0);          // aperture grille
		col *= vec3(m < 1.0 ? 1.0 : 0.86, (m >= 1.0 && m < 2.0) ? 1.0 : 0.86, m >= 2.0 ? 1.0 : 0.86);
		col *= 1.0 - dot(cc * vec2(1.0, 1.6), cc * vec2(1.0, 1.6)) * 0.9; // vignette
		col *= 0.975 + 0.025 * sin(uTime * 50.0);           // flicker
		col += 0.035 * smoothstep(0.96, 1.0, sin((uv.y * 0.6 + uTime * 0.12) * 6.2832)); // rolling bar
		col = pow(col * 1.08, vec3(0.95)) * vec3(1.03, 1.0, 0.94);
		// outside the curved tube is transparent, so the page shows through the corners
		vec2 edge = smoothstep(vec2(0.0), vec2(0.004), bu) * smoothstep(vec2(0.0), vec2(0.004), 1.0 - bu);
		float a = edge.x * edge.y;
		o = vec4(col * a, a);
	}`;

	function mount(root: HTMLElement) {
		const canvas = root.querySelector('canvas')!;
		const gl = canvas.getContext('webgl2', { antialias: false, premultipliedAlpha: true });
		if (!gl) return;

		const sh = (type: number, src: string) => {
			const s = gl.createShader(type)!;
			gl.shaderSource(s, src); gl.compileShader(s);
			if (!gl.getShaderParameter(s, gl.COMPILE_STATUS)) throw new Error(gl.getShaderInfoLog(s) || 'shader');
			return s;
		};
		const prog = gl.createProgram()!;
		try {
			gl.attachShader(prog, sh(gl.VERTEX_SHADER, VERT));
			gl.attachShader(prog, sh(gl.FRAGMENT_SHADER, FRAG));
		} catch (e) { console.warn(e); return; }
		gl.linkProgram(prog);
		gl.useProgram(prog);
		gl.bindVertexArray(gl.createVertexArray());
		const U = (n: string) => gl.getUniformLocation(prog, n);

		const tex = (unit: number, source: TexImageSource, filter: number) => {
			const t = gl.createTexture();
			gl.activeTexture(gl.TEXTURE0 + unit);
			gl.bindTexture(gl.TEXTURE_2D, t);
			gl.pixelStorei(gl.UNPACK_FLIP_Y_WEBGL, true);
			gl.texImage2D(gl.TEXTURE_2D, 0, gl.RGBA, gl.RGBA, gl.UNSIGNED_BYTE, source);
			gl.texParameteri(gl.TEXTURE_2D, gl.TEXTURE_MIN_FILTER, filter);
			gl.texParameteri(gl.TEXTURE_2D, gl.TEXTURE_MAG_FILTER, filter);
			gl.texParameteri(gl.TEXTURE_2D, gl.TEXTURE_WRAP_S, gl.CLAMP_TO_EDGE);
			gl.texParameteri(gl.TEXTURE_2D, gl.TEXTURE_WRAP_T, gl.CLAMP_TO_EDGE);
		};

		let dpr = 1;
		const size = () => {
			dpr = Math.min(window.devicePixelRatio || 1, 2);
			canvas.width = Math.round(root.clientWidth * dpr);
			canvas.height = Math.round(root.clientHeight * dpr);
			gl.viewport(0, 0, canvas.width, canvas.height);
			dirty = true;
		};

		// pointer: real hover on desktop; on touch the lens drifts on its own
		const touch = matchMedia('(hover: none)').matches;
		let mx = -1e4, my = -1e4, tx = -1e4, ty = -1e4, hover = 0, hoverT = touch ? 0.9 : 0;
		canvas.addEventListener('pointermove', (e) => {
			const r = canvas.getBoundingClientRect();
			tx = (e.clientX - r.left) * dpr; ty = (r.bottom - e.clientY) * dpr;
			if (hover < 0.01) { mx = tx; my = ty; }
			hoverT = 1;
		});
		canvas.addEventListener('pointerleave', () => { hoverT = touch ? 0.9 : 0; });

		let visible = false, dirty = true, raf = 0, img: HTMLImageElement | null = null;
		// flicker/rolling bar animate; reduced-motion users get one still frame
		const still = matchMedia('(prefers-reduced-motion: reduce)').matches;
		const animated = !still;
		const t0 = performance.now();
		const frame = (now: number) => {
			raf = 0;
			if (!visible || !img) return;
			const t = still ? 0 : (now - t0) / 1000;
			if (touch && !still) { // slow lissajous drift
				tx = canvas.width * (0.5 + 0.38 * Math.sin(t * 0.35));
				ty = canvas.height * (0.5 + 0.3 * Math.sin(t * 0.53));
			}
			mx += (tx - mx) * 0.18; my += (ty - my) * 0.18;
			hover += (hoverT - hover) * 0.12;
			const settling = Math.abs(tx - mx) + Math.abs(ty - my) > 0.5 || Math.abs(hoverT - hover) > 0.003;
			if (dirty || settling || animated) {
				gl.uniform2f(U('uRes'), canvas.width, canvas.height);
				gl.uniform2f(U('uImg'), img.naturalWidth, img.naturalHeight);
				gl.uniform2f(U('uMouse'), mx, my);
				gl.uniform1f(U('uHover'), hover);
				gl.uniform1f(U('uTime'), t);
				gl.uniform1f(U('uDpr'), dpr);
				gl.uniform1i(U('uTex'), 0);
				gl.drawArrays(gl.TRIANGLES, 0, 3);
				if (!root.classList.contains('gl-ready')) root.classList.add('gl-ready');
				dirty = false;
			}
			// keep looping only while something is moving; otherwise wait for a kick
			if (settling || animated) raf = requestAnimationFrame(frame);
		};
		const kick = () => { if (!raf && visible) raf = requestAnimationFrame(frame); };
		canvas.addEventListener('pointermove', kick);
		canvas.addEventListener('pointerleave', kick);

		new ResizeObserver(() => { size(); kick(); }).observe(root);
		new IntersectionObserver(([e]) => { visible = e.isIntersecting; kick(); }).observe(root);

		const load = new Image();
		load.decoding = 'async';
		load.onload = () => {
			img = load;
			tex(0, load, gl.LINEAR);
			dirty = true; kick();
		};
		load.src = root.dataset.src!;
	}

	document.querySelectorAll<HTMLElement>('[data-banner]').forEach(mount);
</script>
