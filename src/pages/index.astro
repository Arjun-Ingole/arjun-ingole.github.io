---
import { Image } from 'astro:assets';
import Base from '../layouts/Base.astro';
import HoverCard from '../components/HoverCard.astro';
import TechIcon from '../components/TechIcon.astro';
import NowPlaying from '../components/NowPlaying.astro';
import ContribGraph from '../components/ContribGraph.astro';
import BannerShader from '../components/BannerShader.astro';
import { site, links, work, projects, earlier } from '../data/site';
import { getPosts, fmtDate } from '../lib/posts';
import avatar from '../assets/avatar.jpg';
import pazyLogo from '../assets/pazy.png';
import may4Logo from '../assets/may4.svg';

const posts = getPosts();
const logos: Record<string, ImageMetadata> = { Pazy: pazyLogo, 'May4 Automation': may4Logo };

const card = { width: 300, height: 300, borderWidth: 6, shape: 'squircle' as const, borderColor: '#d4d4d8', placement: 'bottom' as const };
---

<Base>
	<section class="intro stagger" style="--d:60ms">
		<BannerShader class="hero-banner" alt="A retro desk: a beige IBM PC, Monkey Island boxes and a boombox" />
		<div class="who">
			<Image class="avatar" src={avatar} alt="Arjun" width={176} height={176} loading="eager" />
			<div class="who-text">
				<h1 class="name display">Arjun Ingole</h1>
				<p class="role"><HoverCard {...card} map={{ lat: 12.9716, lng: 77.5946, zoom: 11, label: 'bengaluru · © openfreemap © openstreetmap' }}>bengaluru</HoverCard>, india</p>
			</div>
		</div>

		<p>
			i'm a founding engineer at <a class="ul" href="https://www.pazy.io/" target="_blank" rel="noopener noreferrer">pazy</a>, where we're building the payments platform businesses use to track every rupee they spend. i move between product, design and engineering, and lately sales too, because building the thing is only half the job.
		</p>
		<p>
			i grew up in a small village near <HoverCard {...card} map={{ lat: 21.1458, lng: 79.0882, zoom: 9, label: 'nagpur · © openfreemap © openstreetmap' }}>nagpur</HoverCard> and taught myself to code building custom roms and <a class="ul" href="https://github.com/Arjun-Ingole/kernel_xiaomi_sm6250" target="_blank" rel="noopener noreferrer">kernels</a> for xiaomi phones, compiling them on aws servers i'd ssh into. that rabbit hole turned out to be a better teacher than any classroom, so i dropped out of college and never looked back.
		</p>
		<p>
			i'm endlessly curious about ai, startups and fintech, and after hours i build tools for coding agents in <span class="hl"><TechIcon tech="ts" brand size={13} />TypeScript</span>, <span class="hl"><TechIcon tech="go" brand size={13} />Go</span> and <span class="hl"><TechIcon tech="rust" size={13} />Rust</span>.
		</p>
		<NowPlaying />
		<p>
			say hi on <a class="ul" href={links.x} target="_blank" rel="noopener noreferrer">x</a> or drop a mail to
			<span class="mail"><a class="ul" href={links.email}>{site.email}</a><button class="copy" data-copy={site.email} aria-label="Copy email address">
				<svg class="i-copy" width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect width="14" height="14" x="8" y="8" rx="2"/><path d="M4 16c-1.1 0-2-.9-2-2V4c0-1.1.9-2 2-2h10c1.1 0 2 .9 2 2"/></svg>
				<svg class="i-check" width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d="M20 6 9 17l-5-5"/></svg>
			</button></span>
		</p>
	</section>

	<section class="section" id="work">
		<h2 class="section-title">Work</h2>
		<ul class="rows">
			{work.map((w) => {
				const Tag = w.href ? 'a' : 'div';
				const attrs = w.href ? { href: w.href, target: '_blank', rel: 'noopener noreferrer' } : {};
				return (
					<li>
						<Tag class="row" {...attrs}>
							<span class="row-main">
								{logos[w.company] && <Image class="co" src={logos[w.company]} alt="" width={32} height={32} />}
								<span class="row-name">{w.company}</span><span class="row-desc">{w.role}</span>
							</span>
							<span class="row-meta">{w.period}</span>
						</Tag>
					</li>
				);
			})}
		</ul>
	</section>

	<ContribGraph />

	<section class="section" id="projects">
		<h2 class="section-title">Projects</h2>
		<ul class="rows">
			{projects.map((p) => (
				<li>
					<a class="row" href={p.href} target="_blank" rel="noopener noreferrer">
						<span class="row-main"><span class="row-name">{p.name}</span><span class="row-desc">{p.blurb}</span></span>
						<span class="row-meta icons">{p.tech.map((t) => <TechIcon tech={t} size={13} brand />)}</span>
					</a>
				</li>
			))}
		</ul>
	</section>

	<section class="section" id="earlier">
		<h2 class="section-title">Earlier</h2>
		<ul class="rows">
			{earlier.map((p) => (
				<li>
					<a class="row" href={p.href} target="_blank" rel="noopener noreferrer">
						<span class="row-main"><span class="row-name">{p.name}</span><span class="row-desc">{p.blurb}</span></span>
						<span class="row-meta icons">{p.tech.map((t) => <TechIcon tech={t} size={13} brand />)}</span>
					</a>
				</li>
			))}
		</ul>
	</section>

	{posts.length > 0 && (
		<section class="section" id="writing">
			<h2 class="section-title">Writing</h2>
			<ul class="rows">
				{posts.slice(0, 5).map((p) => (
					<li>
						<a class="row" href={p.url}>
							<span class="row-main"><span class="row-name">{p.title}</span></span>
							<time class="row-meta" datetime={p.date.toISOString()}>{fmtDate(p.date)}</time>
						</a>
					</li>
				))}
			</ul>
		</section>
	)}
</Base>

<style>
	/* the banner reaches 20px past the text column on each side */
	.intro :global(.hero-banner) {
		--bleed: 20px;
		width: calc(100% + var(--bleed) * 2);
		margin-inline: calc(var(--bleed) * -1);
	}
	/* x-profile layout: avatar straddles the banner's bottom edge,
	   name + location stack underneath, all on the text column's left edge */
	.who { position: relative; z-index: 1; margin: -44px 0 1.4rem; }
	.avatar {
		display: block; width: 88px; height: 88px; border-radius: 20px; object-fit: cover;
		box-shadow: 0 0 0 4px var(--bg);
	}
	.who-text { margin-top: .75rem; }
	.name { margin: 0; font-size: 1.75rem; line-height: 1.1; letter-spacing: -.01em; }
	.role { margin: .2rem 0 0; color: var(--ink-2); }

	.intro p { margin: 0 0 .75rem; color: var(--ink-2); text-wrap: pretty; }
	.intro p:last-child { margin-bottom: 0; }
	.hl { color: var(--ink); white-space: nowrap; }
	.hl :global(svg) { display: inline-block; margin-right: .25rem; vertical-align: -1.5px; }

	.mail { display: inline-flex; align-items: center; gap: .15rem; }
	.copy {
		display: inline-grid; place-items: center; width: 1.4rem; height: 1.4rem;
		border: 0; border-radius: .3rem; background: none; color: var(--ink-3); cursor: pointer;
		transition: color .15s ease, background-color .15s ease;
	}
	.copy:hover { color: var(--ink); background: var(--hover); }
	.copy svg { grid-area: 1 / 1; }
	.copy .i-check { opacity: 0; }
	.copy.done .i-copy { opacity: 0; }
	.copy.done .i-check { opacity: 1; color: var(--ink); }

	.co { display: inline-block; width: 16px; height: 16px; margin-right: .5rem; border-radius: 4px; vertical-align: -3px; }
	.icons { color: var(--ink-2); gap: .45rem; }
	div.row:hover { background: none; }

</style>

<script>
	document.querySelectorAll<HTMLButtonElement>('[data-copy]').forEach((btn) => {
		btn.addEventListener('click', async () => {
			try { await navigator.clipboard.writeText(btn.dataset.copy!); } catch {}
			btn.classList.add('done');
			setTimeout(() => btn.classList.remove('done'), 1400);
		});
	});
</script>
