---
import Base from '../layouts/Base.astro';
import { getPosts, fmtDate } from '../lib/posts';

const posts = getPosts();
---

<Base title="Writing" description="notes on databases, systems, and whatever i broke this week.">
	<h1 class="title">Writing</h1>
	<p class="lede">notes on databases, systems, and whatever i broke this week.</p>

	<ul class="rows list">
		{posts.map((p) => (
			<li>
				<a class="row" href={p.url}>
					<span class="row-main"><span class="row-name">{p.title}</span></span>
					<time class="row-meta" datetime={p.date.toISOString()}>{fmtDate(p.date)}</time>
				</a>
			</li>
		))}
	</ul>
</Base>

<style>
	.title { margin: 0; font-size: 14px; font-weight: 500; }
	.lede { margin: .25rem 0 0; color: var(--ink-2); }
	.list { margin-top: 1.5rem; }
</style>
